# Все публичные настройки находятся в src/content/*.ts.
# Секреты для статического сайта не требуются и не должны попадать в NEXT_PUBLIC_*.
NEXT_TELEMETRY_DISABLED=1
# Preview: PORT=4173 по умолчанию. Playwright задаёт 4175 автоматически.
# Не указывайте внешние/production URL в тестах.
# QA_ARTIFACT_DIR=.artifacts/playwright (необязательная папка прямого Playwright-запуска)
