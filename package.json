{
  "name": "manic-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/normalize-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "npm test",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=src/lib/*.ts tests/*.test.ts",
    "test:quick": "node scripts/qa.mjs quick",
    "test:full": "node scripts/qa.mjs full",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:stress:reload": "node scripts/qa-reload-stress.mjs",
    "test:a11y": "playwright test --project=accessibility",
    "test:visual": "playwright test --project=visual",
    "test:visual:quick": "playwright test --project=visual --grep @visual-quick",
    "test:visual:candidates": "playwright test --project=visual --update-snapshots=missing",
    "test:ui": "playwright test --ui --project=chromium",
    "test:report": "node scripts/qa.mjs report",
    "test:report:open": "node scripts/qa.mjs open",
    "test:install": "playwright install chromium firefox webkit",
    "check:release": "tsx scripts/check-release.ts",
    "build:release": "npm run check:release && npm run build",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
